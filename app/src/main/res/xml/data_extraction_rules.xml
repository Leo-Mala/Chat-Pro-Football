<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          Bancos Room completos não entram no cloud backup: um único slot FC26 pode persistir
          dezenas de milhares de jogadores e ultrapassar a quota de backup por app. O cloud
          preserva apenas metadados/preferências pequenos; saves completos são transferidos no
          fluxo device-to-device abaixo.
        -->
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="brasfut_retro_saves.xml" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device não usa a quota de cloud backup e deve levar todos os slots Room. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="brasfut_retro_saves.xml" />
    </device-transfer>
</data-extraction-rules>
