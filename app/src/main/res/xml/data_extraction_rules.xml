<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          Como existem regras <include>, somente os caminhos explicitamente incluídos participam
          do cloud backup. Os bancos Room completos por slot ficam fora por omissão para evitar a
          quota de backup por app; saves completos seguem pelo fluxo device-to-device abaixo.
        -->
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="brasfut_retro_saves.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device não usa a quota de cloud backup e deve levar todos os slots Room. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="brasfut_retro_saves.xml" />
    </device-transfer>
</data-extraction-rules>
