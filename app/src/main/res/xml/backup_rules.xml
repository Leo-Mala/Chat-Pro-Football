<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Android 11 e anteriores usam este arquivo tanto para cloud backup quanto para migração
      device-to-device. Os bancos Room por slot só entram quando o transporte declara o flag
      deviceToDeviceTransfer; assim, o cloud não tenta enviar dezenas de milhares de jogadores,
      mas uma migração local entre aparelhos preserva as carreiras completas.
    -->
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="brasfut_retro_saves.xml" />
</full-backup-content>
