<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Android 11 e anteriores usam este arquivo para cloud backup. Como existem regras <include>,
      somente os caminhos explicitamente incluídos participam do backup; os bancos Room por slot
      ficam fora por omissão, evitando estourar a quota de cloud do app. Android 12+ usa
      data_extraction_rules.xml e mantém os bancos completos apenas no fluxo device-to-device.
    -->
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="brasfut_retro_saves.xml" />
</full-backup-content>
