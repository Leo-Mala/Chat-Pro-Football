<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Todos os bancos Room por slot vivem no domínio database e precisam viajar juntos. -->
    <include domain="database" path="." />
    <!-- DataStore Preferences usa files/datastore; contém metadados dos slots e preferências. -->
    <include domain="file" path="datastore/" />
    <!-- Compatibilidade com metadados/preferências de versões legadas. -->
    <include domain="sharedpref" path="brasfut_retro_saves.xml" />
</full-backup-content>
